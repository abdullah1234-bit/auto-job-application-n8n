        16
      ],
      "webhookId": "0c171d1b-56df-486f-bc33-72c28e0c26ba",
      "credentials": {
        "gmailOAuth2": {
          "id": "fM0qwY7O1tLXFykm",
          "name": "Gmail OAuth2 API"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "combinator": "and",
          "options": {
            "caseSensitive": true,
