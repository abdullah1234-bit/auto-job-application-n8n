        "message": "={{ \"<h2>Ready to Apply!</h2>\" +\"<p><b>Role:</b> \" + $(\"Process Each Job\").item.json.title + \"<br>\" +\"<b>Company:</b> \" + $(\"Process Each Job\").item.json.company_name + \"<br>\" +\"<b>Location:</b> \" + $(\"Process Each Job\").item.json.location + \"<br>\" +\"<b>Apply Link:</b> <a href='\" + $(\"Process Each Job\").item.json.url + \"'>\" + $(\"Process Each Job\").item.json.url + \"</a></p>\" +\"<h3>Your Tailored Cover Letter</h3>\" +\"<p style='white-space:pre-wrap'>\" + $(\"Tailor CV & Cover Letter\").item.json.output.tailored_cover_letter + \"</p>\" +\"<h3>CV Tweaks for This Role</h3>\" +\"<p style='white-space:pre-wrap'>\" + $(\"Tailor CV & Cover Letter\").item.json.output.cv_changes + \"</p>\" }}",
        "options": {
          "appendAttribution": false
        }
      },
