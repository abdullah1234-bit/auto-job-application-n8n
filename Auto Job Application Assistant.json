    {
      "parameters": {
        "promptType": "define",
        "text": "=You are tailoring a job application.\n\n== CANDIDATE ==\n{{ $(\"Job Search Config\").item.json.candidateName }}\n\n== CV (use only facts here, never invent) ==\n{{ $(\"Job Search Config\").item.json.baseCV }}\n\n== JOB ==\nTitle: {{ $(\"Process Each Job\").item.json.title }}\nCompany: {{ $(\"Process Each Job\").item.json.company_name }}\nLocation: {{ $(\"Process Each Job\").item.json.location }}\nDescription: {{ $(\"Process Each Job\").item.json.description }}\n\nReturn the 5 structured fields:\n1. relevance_score 0-100 (how well the candidate fits)\n2. matches_field true/false\n3. fit_summary 2-3 sentences\n4. tailored_cover_letter max 250 words using only real CV facts\n5. cv_changes concrete suggestions on what to emphasise",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are an expert career coach. Only use facts from the CV. Never fabricate employers, dates or qualifications. Return only the structured output."
        }
      },
      "id": "43a7631c-1fa2-4b6a-a493-afc855228b8c",
      "name": "Tailor CV & Cover Letter",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        1568,
        112
      ]
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "claude-sonnet-4-6",
          "cachedResultName": "Claude Sonnet 4.6"
        },
        "options": {
          "maxTokensToSample": 2000,
          "temperature": 0.3
        }
      },
      "id": "7f9b1ec3-670e-4fe5-ab7c-297b28a686d5",
      "name": "Claude Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "typeVersion": 1.5,
      "position": [
        1584,
        336
      ],
      "credentials": {
        "anthropicApi": {
          "id": "CBLXyWZZwNnsaFMp",
          "name": "Anthropic account"
        }
      }
    },
    {
      "parameters": {
        "jsonSchemaExample": "{ \"relevance_score\": 85, \"matches_field\": true, \"fit_summary\": \"Strong fit because...\", \"tailored_cover_letter\": \"Dear Hiring Manager...\", \"cv_changes\": \"Emphasise Python and ML project X...\" }"
      },
      "id": "6335fefa-c941-4d79-9d24-31a0400b70e3",
      "name": "Parse Application",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        1712,
        336
      ]
    },
    {
      "parameters": {
        "conditions": {
          "combinator": "and",
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 1
          },
          "conditions": [
            {
              "leftValue": "={{ $json.output.relevance_score }}",
              "operator": {
                "type": "number",
                "operation": "gte"
              },
              "rightValue": "={{ $(\"Job Search Config\").item.json.minRelevance }}"
            }
          ]
        },
        "options": {}
      },
      "id": "6f4292f2-229b-449b-9fa2-9bb9173105c5",
      "name": "Relevant Enough?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        1920,
        112
      ]
    },
    {
      "parameters": {
        "operation": "sendAndWait",
        "sendTo": "={{ $(\"Job Search Config\").item.json.notifyEmail }}",
        "subject": "={{ \"New Werkstudent match: \" + $(\"Process Each Job\").item.json.title + \" at \" + $(\"Process Each Job\").item.json.company_name }}",
        "message": "={{ \"New Werkstudent job matched your profile!\\n\\n\" +\"Role: \" + $(\"Process Each Job\").item.json.title + \"\\n\" +\"Company: \" + $(\"Process Each Job\").item.json.company_name + \"\\n\" +\"Location: \" + $(\"Process Each Job\").item.json.location + \"\\n\" +\"Match Score: \" + $(\"Tailor CV & Cover Letter\").item.json.output.relevance_score + \"/100\\n\" +\"Apply Link: \" + $(\"Process Each Job\").item.json.url + \"\\n\\n\" +\"WHY IT FITS:\\n\" + $(\"Tailor CV & Cover Letter\").item.json.output.fit_summary + \"\\n\\n\" +\"TAILORED COVER LETTER:\\n\" + $(\"Tailor CV & Cover Letter\").item.json.output.tailored_cover_letter + \"\\n\\n\" +\"CV TWEAKS:\\n\" + $(\"Tailor CV & Cover Letter\").item.json.output.cv_changes }}",
        "approvalOptions": {
          "values": {
            "approvalType": "double",
            "approveLabel": "Apply to this job",
            "disapproveLabel": "Skip this job"
          }
        },
        "options": {
          "limitWaitTime": {
            "values": {
              "resumeAmount": 7,
              "resumeUnit": "days"
            }
          },
          "appendAttribution": false
        }
      },
      "id": "b4e889d0-9405-43ad-af96-8225ef984105",
      "name": "Request Approval",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
